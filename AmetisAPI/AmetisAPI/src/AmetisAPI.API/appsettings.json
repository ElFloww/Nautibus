{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllocatedMemory": 2048,
  "ConnectionStrings": {
    "Database": "TODO EF Connection",
    "Redis": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Local\\Ametisapi\\Logs\\logs-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.ffff}|{RequestId}|{SourceContext}|{Level:u3}|{Properties:j}|{Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Ametisapi"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Realtime": {
    "CollectInProcess": false
  },
  "Gtfs": {
    "NetworkFeedUrl": "https://www.data.gouv.fr/api/1/datasets/r/571e3014-066d-4bd6-9f73-fb8065c928c6",
    "RealtimeFeedUrl": "https://www.data.gouv.fr/api/1/datasets/r/5bc8b7dc-0d4e-48e7-b2ec-eccfe3702c19",
    "VehiclePositionsUrl": "https://proxy.transport.data.gouv.fr/resource/ametis-amiens-gtfs-rt-vehicle-position",
    "TripUpdatesUrl": "https://proxy.transport.data.gouv.fr/resource/ametis-amiens-gtfs-rt-trip-update",
    "AlertsUrl": "https://proxy.transport.data.gouv.fr/resource/ametis-amiens-gtfs-rt-alerts"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Nautibus",
    "PublicUrl": "",
    "PickupDirectory": ""
  },
  "Push": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": ""
  }
}